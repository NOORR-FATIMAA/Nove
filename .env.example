# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nove

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_DAYS=30

# Admin seed user
ADMIN_NAME=Nove Admin
ADMIN_EMAIL=admin@nove.local
ADMIN_PASSWORD=

# SMTP (optional - falls back to console logging in dev if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nove <hello.nove.pk@gmail.com>
